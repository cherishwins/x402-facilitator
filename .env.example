# Address that receives payments, on Base. REQUIRED — the service refuses to
# start without it. There is deliberately no default: a fallback address means
# payments quietly land in a wallet nobody holds the keys to.
PAYMENT_ADDRESS=

# Shared secret for HMAC-signing settlement callbacks. REQUIRED, and "changeme"
# is rejected. Anyone who can reach /webhook with this secret can mark payments
# settled, so treat it like a private key.
#   generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Comma-separated origins allowed to call this facilitator from a browser.
# Defaults to https://kim.juche.org. A wildcard here would let any site on the
# internet drive your payment flow.
ALLOWED_ORIGINS=https://kim.juche.org

# Base mainnet RPC. The public endpoint is rate-limited; use a provider URL
# for anything with real traffic.
BASE_RPC_URL=https://mainnet.base.org

# Block confirmations required before a payment is treated as settled.
MIN_CONFIRMATIONS=2

# Smallest accepted payment. Custodial deposit addresses commonly reject dust.
MIN_AMOUNT_USDC=0.01

# Optional: persist payments to Supabase. Without these, state is in-memory and
# a restart drops pending payments (settled ones remain recoverable on-chain).
SUPABASE_URL=
SUPABASE_KEY=

# Set automatically by Render.
PORT=8000
